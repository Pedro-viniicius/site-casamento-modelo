# Site de casamento · Apache/LiteSpeed (Hostinger)
# Libera esta pasta (a raiz do repositório tem "Require all denied").
Require all granted
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8
AddType application/javascript .mjs
AddType application/geo+json .geojson
AddType text/calendar .ics

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Força HTTPS (o SSL é ativado no hPanel → SSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Repassa o cabeçalho Authorization ao PHP (importador do Etiqueta)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 3) Bloqueia pastas privadas (caso tenham sido enviadas para dentro do public_html) e arquivos ocultos
  RewriteRule ^(_privado|config|database|tools|inc|data|vendor)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^boot\.php$ - [F,L]

  # 4) URLs amigáveis para compartilhar
  RewriteRule ^presenca/?$ /#presenca [R=302,NE,L]
  RewriteRule ^presentes/?$ /#presentes [R=302,NE,L]
  RewriteRule ^como-chegar/?$ /#local [R=302,NE,L]
  RewriteRule ^calendario\.ics$ /api/ics.php [L]
  RewriteRule ^admin$ /admin/ [R=301,L]
</IfModule>

# Compressão (a LiteSpeed da Hostinger também serve brotli automaticamente)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/geo+json image/svg+xml text/calendar
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/geo+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # Cache longo: fontes, imagens e bibliotecas (o CSS/JS principal leva ?v=data no HTML)
  <FilesMatch "\.(woff2|png|jpe?g|webp|avif|gif|ico|geojson)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Módulos JS importados entre si não levam ?v=: revalida sempre (304 barato) para nunca misturar versões.
  <FilesMatch "\.(js|mjs)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Bloqueia arquivos sensíveis por extensão
<FilesMatch "\.(sql|md|sh|mjs\.map|log|ini|env|bak|example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^confetti\.module\.mjs$">
  Require all granted
</FilesMatch>
